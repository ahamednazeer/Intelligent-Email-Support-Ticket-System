# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000

# SMTP (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="Support Team <your@gmail.com>"

# Routing / Review
ASSIGNMENT_REQUIRES_REVIEW=true
KEYWORD_OVERRIDE_MIN=1
KEYWORD_CONFLICT_MARGIN=1
ML_MIN_CONFIDENCE=0.55
# Options: grok_first (default), grok, local
CLASSIFIER_PROVIDER=grok_first

# Grok (xAI) classification
# Use either GROK_API_KEY or XAI_API_KEY
GROK_API_KEY=
XAI_API_KEY=
# Best-quality default for segmentation
GROK_MODEL=grok-4
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_TIMEOUT_SECONDS=20
GROK_MAX_TOKENS=220
GROK_MIN_CONFIDENCE=0.55

# IMAP polling (Gmail inbox ingestion)
IMAP_POLLING_ENABLED=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your@gmail.com
IMAP_PASSWORD=your_app_password
IMAP_FOLDER=INBOX
IMAP_POLL_INTERVAL=60
IMAP_SEARCH_CRITERIA=UNSEEN
IMAP_MARK_SEEN=true
IMAP_SSL=true
IMAP_LOCKFILE=/tmp/imap_poller.lock
IMAP_ALLOW_FROM=
IMAP_ALLOW_DOMAINS=
IMAP_BLOCK_FROM=
IMAP_BLOCK_DOMAINS=
IMAP_BLOCK_SUBJECT=
IMAP_BLOCK_NOREPLY=false
